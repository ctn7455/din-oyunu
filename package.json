{
  "name": "inanc-pusulasi",
  "version": "1.1.1",
  "description": "İnanç Pusulası & Kuvvetli Fen - MEB 6. Sınıf Eğitici Oyun Portalı",
  "main": "electron_main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux AppImage deb",
    "build:all": "electron-builder -wl",
    "build:mac": "electron-builder --mac"
  },
  "keywords": ["din-kulturu", "fen-bilimleri", "meb", "egitici-oyun", "akilli-tahta", "pardus", "etap", "offline"],
  "author": "Yasin Demirtaş",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.inancpusulasi.app",
    "productName": "İnanç Pusulası",
    "directories": { "output": "dist" },
    "files": ["**/*", "!dist/**", "!node_modules/**", "!*.md"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Education",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "İnanç Pusulası"
    }
  }
}